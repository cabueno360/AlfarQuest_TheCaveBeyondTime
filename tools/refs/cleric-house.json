":9,"flip":false,"cx":0,"cy":0},{"x":342.4,"y":732.8,"kind":"h_records","v":0,"s":0.6,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":240,"y":688,"kind":"h_candle","v":0,"s":0.6,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1008,"y":656,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1008,"y":732.8,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1072,"y":656,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1072,"y":732.8,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1136,"y":656,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1136,"y":732.8,"kind":"h_chair_b","v":0,"s":0.6,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":1244.8,"y":688,"kind":"h_bench","v":0,"s":0.75,"solid":true,"r":16,"flip":false,"cx":0,"cy":0},{"x":976,"y":784,"kind":"h_side_table","v":0,"s":0.8,"solid":true,"r":10,"flip":false,"cx":0,"cy":0},{"x":976,"y":764.8,"kind":"h_letter","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1136,"y":617.6,"kind":"h_candelabra","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0}],"npcs":[],"portals":[{"x":688,"y":816,"r":42,"target":"__overworld__","label":"outside","verb":"Step","retX":0,"retY":0},{"x":1232,"y":144,"r":42,"target":"cleric_house_upper","label":"upstairs","verb":"Go","retX":0,"retY":0}],"examinables":[{"x":560,"y":636.8,"r":44,"title":"the armour stand","verb":"Examine","kind":"note","pages":["The stand where his blessed plate once hung. He wore it down into the cave — slept in it, those last nights at her side. It stands empty now."]},{"x":848,"y":636.8,"r":44,"title":"the weapon rack","verb":"Examine","kind":"note","pages":["A cradle for the gilded mace of his clericy. Empty. He carried it into the dark, where a prayer is worth less than a good swing."]},{"x":688,"y":643.2,"r":44,"title":"the wedding portrait","verb":"Examine","kind":"portrait","pages":["A wedding portrait above the door. \"Hair of gold more brilliant than any gilding,\" he once said of her. You would not know her now from the woman upstairs."]},{"x":784,"y":752,"r":44,"title":"a dried bouquet","verb":"Examine","kind":"note","pages":["A bouquet from some warmer year, dried to paper and kept by the door. Nothing has bloomed in this valley in five winters."]},{"x":144,"y":176,"r":44,"title":"the storeroom","verb":"Search","kind":"note","pages":["A half-sack of grain, a barrel of salt pork nearly gone. He rationed the house down to nothing so the village might have a little more."]},{"x":784,"y":144,"r":44,"title":"the kitchen shelves","verb":"Examine","kind":"note","pages":["Dried herbs on strings, a cold kettle, a loaf gone hard. A kitchen that has cooked for two, then for one, and lately for no one at all."]},{"x":176,"y":400,"r":44,"title":"the fireplace","verb":"Examine","kind":"note","pages":["The hearth he kept lit against the winter. Someone has banked the coals since he left — her father, most likely, come up from the village to keep the cold off her."]},{"x":144,"y":444.8,"r":44,"title":"the bookshelves","verb":"Read","kind":"note","pages":["Saints' fables, a seminary primer, sermons in his own careful hand. He was full of hope when he wrote these, a young priest fresh from the seminary."]},{"x":1232,"y":380.8,"r":44,"title":"the prayer altar","verb":"Pray","kind":"plaque","pages":["A small shrine to the Holy Light, worn smooth where he knelt. His canticle is still legible on the rail:","\"O Holy Light of the world. Bringer of Dawn. King of all Kings. Grant me the strength I need. I am a child stumbling in the wilderness, blind and lost and cold without you.\"","\"There are no stars without your grace. No beauty without your love. No hope without your hand. Watch over me — and over her.\""]},{"x":1296,"y":419.2,"r":44,"title":"the sacred chalice","verb":"Examine","kind":"relic","pages":["A chalice of the Holy Light, gilt worn to brass at the lip. He blessed the village's water from it, back when there were enough left to gather. It has not been filled in a long while."]},{"x":1302.4,"y":384,"r":44,"title":"the prayer books","verb":"Read","kind":"plaque","pages":["Two breviaries at the rail, their spines cracked from use. One falls open of its own accord at the office for the sick — the page is soft as cloth from being turned so often.","In the margin, in the same careful hand as the journal: \"Said again tonight. And again. He does not answer, but I do not think that means He is not listening.\""]},{"x":304,"y":752,"r":44,"title":"the village records","verb":"Read","kind":"note","pages":["Harvest ledgers, column after column struck through. \"Came up grey,\" reads one margin. \"Froze before the reaping,\" reads the next. A census with more names crossed out each year than added."]},{"x":1244.8,"y":688,"r":44,"title":"the advice bench","verb":"Examine","kind":"note","pages":["The bench where villagers waited their turn — a marriage to bless, a quarrel to settle, a sick child to pray over. He was the first they sought, once. Fewer come now; fewer are left to come."]},{"x":976,"y":784,"r":44,"title":"letters from his Order","verb":"Read","kind":"letter","pages":["A bundle of missives from the seminary, the topmost still unanswered.","\"...more clerics and medics called to the front than we have to send. Blazwitz and Koerig have joined against Tellaran, but the line is pushed north. We may yet recall you.\"","\"The invaders care nothing for the faith, nor the lands they ravage. Worshippers of mad gods, the lot of them.\" He never sent his reply."]}],"containers":[],"discoveries":[],"arches":[],"creatures":[]},"cleric_house_upper":{"name":"The Approach","cols":44,"rows":24,"tile":32,"tiles":["############################################","############################################","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##........................................##","##........................................##","##..............#..........#..............##","##..............#..........#..............##","########..###########..##########..#########","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##........................................##","##........................................##","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","##..............#..........#..............##","############################################","############################################"],"spawn":{"x":688,"y":496},"exit":{"x":1296,"y":272},"caveMouth":{"x":1296,"y":272},"safeZones":[{"x0":4,"y0":56,"x1":24,"y1":79},{"x0":28,"y0":38,"x1":40,"y1":48},{"x0":44,"y0":18,"x1":66,"y1":36},{"x0":33,"y0":4,"x1":48,"y1":18},{"x0":16,"y0":18,"x1":30,"y1":30},{"x0":106,"y0":50,"x1":128,"y1":66},{"x0":42,"y0":100,"x1":60,"y1":118},{"x0":86,"y0":40,"x1":106,"y1":55},{"x0":24,"y0":71,"x1":38,"y1":80}],"props":[{"x":220.8,"y":259.2,"kind":"h_rug","v":0,"s":0.85,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":208,"y":227.2,"kind":"h_bed_mirka","v":0,"s":0.95,"solid":true,"r":16,"flip":false,"cx":0,"cy":0},{"x":131.2,"y":188.8,"kind":"h_chair","v":0,"s":0.72,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":112,"y":124.8,"kind":"h_curtains","v":0,"s":0.7,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":284.8,"y":176,"kind":"h_bedside","v":0,"s":0.78,"solid":true,"r":11,"flip":false,"cx":0,"cy":0},{"x":284.8,"y":153.6,"kind":"h_journal","v":0,"s":0.5,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":384,"y":240,"kind":"h_apothecary","v":0,"s":0.78,"solid":true,"r":18,"flip":false,"cx":0,"cy":0},{"x":432,"y":163.2,"kind":"h_herbs","v":0,"s":0.6,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":323.2,"y":259.2,"kind":"h_washstand","v":0,"s":0.7,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":316.8,"y":220.8,"kind":"h_flowers","v":0,"s":0.5,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":252.8,"y":227.2,"kind":"h_panacea","v":0,"s":0.5,"solid":true,"r":7,"flip":false,"cx":0,"cy":0},{"x":124.8,"y":144,"kind":"h_candelabra","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":438.4,"y":272,"kind":"h_candle","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1136,"y":176,"kind":"h_bed","v":0,"s":0.88,"solid":true,"r":18,"flip":false,"cx":0,"cy":0},{"x":1251.2,"y":156.8,"kind":"h_cupboard","v":0,"s":0.85,"solid":true,"r":12,"flip":false,"cx":0,"cy":0},{"x":1008,"y":240,"kind":"h_plant","v":0,"s":0.6,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1264,"y":124.8,"kind":"h_candle","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":176,"y":508.8,"kind":"h_desk","v":0,"s":0.85,"solid":true,"r":15,"flip":false,"cx":0,"cy":0},{"x":176,"y":553.6,"kind":"h_chair","v":0,"s":0.62,"solid":true,"r":9,"flip":false,"cx":0,"cy":0},{"x":220.8,"y":483.2,"kind":"h_records","v":0,"s":0.58,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":131.2,"y":451.2,"kind":"h_bookshelf","v":0,"s":0.8,"solid":true,"r":12,"flip":false,"cx":0,"cy":0},{"x":131.2,"y":598.4,"kind":"h_bookshelf","v":0,"s":0.8,"solid":true,"r":12,"flip":false,"cx":0,"cy":0},{"x":272,"y":444.8,"kind":"h_candle","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":688,"y":432,"kind":"ladder","v":28,"s":0.7,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":624,"y":604.8,"kind":"h_chest","v":0,"s":0.85,"solid":true,"r":12,"flip":false,"cx":0,"cy":0},{"x":752,"y":604.8,"kind":"h_cabinet","v":0,"s":0.82,"solid":true,"r":12,"flip":false,"cx":0,"cy":0},{"x":1232,"y":508.8,"kind":"h_bench","v":0,"s":0.72,"solid":true,"r":15,"flip":false,"cx":0,"cy":0},{"x":1008,"y":451.2,"kind":"h_flowers","v":0,"s":0.5,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1104,"y":451.2,"kind":"h_plant","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1200,"y":451.2,"kind":"h_flowers_yellow","v":0,"s":0.5,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1296,"y":451.2,"kind":"h_flowers","v":0,"s":0.5,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":976,"y":624,"kind":"h_candelabra","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0},{"x":1296,"y":624,"kind":"h_candle","v":0,"s":0.55,"solid":false,"r":0,"flip":false,"cx":0,"cy":0}],"npcs":[{"id":"mirka","x":208,"y":188.8},{"id":"mirkafather","x":336,"y":144}],"portals":[{"x":688,"y":432,"r":42,"target":"cleric_house","label":"downstairs","verb":"Go","retX":0,"retY":0}],"examinables":[{"x":131.2,"y":188.8,"r":44,"title":"the vigil chair","verb":"Examine","kind":"note","pages":["A hard wooden chair drawn up to the bedside, its seat worn smooth. He slept upright in it for the better part of a year, in his full armour, so as never to leave her."]},{"x":284.8,"y":176,"r":44,"title":"the Cleric's journal","verb":"Read","kind":"journal","pages":["The Cleric's journal, in his own careful hand, left open on the nightstand the morning he followed Cerno down into the cave.","Her father came in the dark with a stranger — Cerno, a warrior of Kaladash, grim and honest. He put into my hand a phial of panacea, drawn, he swore, from the Cave Beyond Time. I did not believe him. I drank his word like a dying man drinks water.","The first month, the wasting slowed. Her fingers looked human again. She wakes only minutes a day, but each waking is more determined than the last. I have not told her of my bargain — only that through her father's diligence and the will of God, we found a way.","A letter from my Order. More healers called to the war than exist to send; Blazwitz and Koerig have joined against Tellaran, and the line is pushed north. They speak of recalling me. Outside my window they light the corpse-pyres now, great pillars of flame, and all I can do is pray He accepts the departed.","Three months, and her progress has stalled. Then her skin grew pale as the snow again, and bruises rose wherever I touched her, as though her flesh rejected me. The panacea's gift was only a loan. There has been no waking in weeks.","Cerno comes tomorrow to lead me to the cave, and I will descend into the madness he promised. Mirka — tomorrow is the first time I will leave your side in nearly a year. By God, at least I had this year with you. Come, Cerno. Lead me on to damnation."]},{"x":384,"y":240,"r":44,"title":"the medicine table","verb":"Examine","kind":"note","pages":["Phials and cloths, a bowl of water gone cold, herbs ground to paste. Prayer, ritual, divination, every miracle he was blessed with — he tried them all on the wasting, and the wasting did not so much as slow."]},{"x":316.8,"y":220.8,"r":44,"title":"wilting flowers","verb":"Examine","kind":"note","pages":["Fresh flowers someone still brings to the bedside, though they wilt within a day in the cold of this room. A small, stubborn kindness."]},{"x":252.8,"y":227.2,"r":44,"title":"the Panacea phial","verb":"Examine","kind":"relic","pages":["The phial Cerno drew from the Cave Beyond Time — no larger than a green bean, its gilt water long since drunk, its wax seal broken. Six drops. It bought her a single month, and Cerno's price for it was the Cleric's own descent into madness."]},{"x":1136,"y":176,"r":44,"title":"the master bed","verb":"Examine","kind":"note","pages":["His own bed, made and unslept-in. Why lie here, when she was three doors down and every night might be the last? He kept his vigil in the chair beside hers."]},{"x":176,"y":508.8,"r":44,"title":"the study desk","verb":"Read","kind":"note","pages":["A half-written sermon on righteousness, a map of the valley and its white-peaked mountains, a missive to the seminary begun and abandoned. He had run clean out of things to say to God."]},{"x":624,"y":604.8,"r":44,"title":"Mirka's things","verb":"Search","kind":"note","pages":["A chest of her belongings, folded and put away: a summer dress, a spindle, letters he wrote her before they married. He could not bear to look at them, and could not bear to throw them out."]},{"x":1232,"y":508.8,"r":44,"title":"the balcony","verb":"Examine","kind":"note","pages":["A narrow balcony over the village. From here you can see the frozen slopes where the sheep once grazed on shockingly green grass, and the smoke of the pyres. He came out here to pray where she could not hear him weep."]}],"containers":[],"discoveries":[],"arches":[],"creatures":[]},"mage_school":{"name":"The Approach","cols":44,"rows":24,"tile":32,"tiles":["############################################","############################################","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##........................................##","##........................................##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","##............#..............#............##","############################################","############################################"],"spawn":{"x":688,"y":624},"