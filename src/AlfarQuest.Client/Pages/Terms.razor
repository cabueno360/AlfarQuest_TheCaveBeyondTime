@page "/terms"
@inject Translator L

<PageTitle>@L["Terms"] · Alfar Quest</PageTitle>

<article class="aq-doc">
    <h1>@L["Terms of Service"]</h1>

    <p class="aq-doc-lede">
        @L["Alfar Quest is a game built around the music it takes its story from. These are the terms in the same spirit — short, and meant to be read."]
    </p>

    <h2>@L["Your account"]</h2>
    <ul>
        <li>@L["One account per person. Keep your password to yourself."]</li>
        <li>@L["You are responsible for what happens under your account."]</li>
        <li>@L["Tell us if you think someone else has your password, and change it."]</li>
    </ul>

    <h2>@L["What you upload"]</h2>
    <ul>
        <li>@L["Avatars must be images you have the right to use."]</li>
        <li>@L["Anything unlawful, or made to harass, will be removed with the account."]</li>
    </ul>

    <h2>@L["The game itself"]</h2>
    <p>
        @L["It is offered as it is. Progress is stored on a best-effort basis; this is not a service with an uptime promise behind it."]
    </p>

    <p class="aq-doc-foot"><a class="aq-link" href="/">@L["Back to the gate"]</a></p>
</article>
