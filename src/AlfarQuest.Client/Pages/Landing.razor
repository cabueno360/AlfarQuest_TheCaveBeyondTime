@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using AlfarQuest.Client.Components.Title
@inject Translator L

@* The only page anonymous visitors are meant to see. It sells the game and
   points at the two doors; it loads no game code and touches no game data. *@

<PageTitle>Alfar Quest</PageTitle>

<div class="aq-landing">
    <div class="aq-keyart" aria-hidden="true"></div>
    <div class="aq-vignette" aria-hidden="true"></div>

    <div class="aq-landing-inner">
        <BrandHeader />

        <p class="aq-tagline">
            @L["Beneath Kae Ychel lies the Cave Beyond Time, and everything three ruined souls have left to lose. Take up the torch."]
        </p>

        <AuthorizeView>
            <Authorized>
                <p class="aq-hint">@L.Format("Welcome back, {0}.", context.User.Identity?.Name)</p>
                <div class="aq-landing-actions">
                    <a class="aq-btn aq-begin" href="/heroes">@L["Continue the Descent"]</a>
                    <a class="aq-btn ghost" href="/profile">@L["Your profile"]</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="aq-landing-actions">
                    <a class="aq-btn aq-begin" href="/signup">@L["Create an Account"]</a>
                    <a class="aq-btn ghost" href="/signin">@L["Sign In"]</a>
                </div>
                <p class="aq-hint">@L["An account keeps your party, your gold and your progress."]</p>
            </NotAuthorized>
        </AuthorizeView>

        <ul class="aq-landing-points">
            <li><span aria-hidden="true">◆</span> @L["Three delvers, each with their own way through the dark."]</li>
            <li><span aria-hidden="true">◆</span> @L["An open approach above ground, and the mine below it."]</li>
            <li><span aria-hidden="true">◆</span> @L["Attributes, skills, gear and crafting that all reach the fight."]</li>
        </ul>

        @* The picker lives on the landing page as well as in Settings: someone
           arriving for the first time should be able to change the language
           before making an account, not after. *@
        <LanguagePicker />
    </div>
</div>
