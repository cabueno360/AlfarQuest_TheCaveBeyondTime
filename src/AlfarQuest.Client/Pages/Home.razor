@page "/heroes"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using AlfarQuest.Client.Components.Title
@inject Translator L

@* Hero select. Behind [Authorize]: it is the first screen that reads game data,
   and the API it reads from requires the same token.

   It moved off "/" when the landing page took that route — anonymous visitors
   now meet the gate, not the roster. *@
<div class="aq-menu">
    <div class="aq-keyart"></div>
    <div class="aq-vignette"></div>

    <div class="aq-menu-inner">
        <BrandHeader />

        <p class="aq-tagline">
            @L["Three souls stand at the mouth of the Cave Beyond Time."]<br />
            @L["Choose who leads the descent — you may take up any of them once the dark closes in."]
        </p>

        @if (Heroes is null)
        {
            <p class="aq-hint">@L["Reading the old records…"]</p>
        }
        else
        {
            @* The slot picker: every delve this player keeps, each with its own
               name, place and hour — plus New Game. The roster below shows the
               party of whichever slot is chosen. *@
            @if (_saves is { Count: > 0 })
            {
                <div class="aq-slots" role="listbox" aria-label="@L["Your delves"]">
                    @foreach (var s in _saves)
                    {
                        <div class="aq-slot @(SelectedSave?.Id == s.Id && !_newGame ? "sel" : "")"
                             role="option" tabindex="0" @key="s.Id"
                             @onclick="() => SelectSave(s)">
                            <span class="aq-slot-name">@SlotName(s)</span>
                            <span class="aq-slot-meta">@Prettify(s.Region) · @Ago(s.UpdatedAt)@(s.PlaytimeSeconds > 0 ? $" · {Duration(s.PlaytimeSeconds)}" : "")</span>
                            <span class="aq-slot-del @(_confirmDelete == s.Id ? "arm" : "")"
                                  title="@L["Delete this delve"]"
                                  @onclick:stopPropagation="true" @onclick="() => DeleteSave(s)">
                                @(_confirmDelete == s.Id ? L["Sure?"] : "✕")
                            </span>
                        </div>
                    }
                    <div class="aq-slot aq-slot-new @(_newGame ? "sel" : "")" role="option" tabindex="0"
                         @onclick="OpenNewGame">
                        <span class="aq-slot-name">＋ @L["New Game"]</span>
                        <span class="aq-slot-meta">@L["A fresh descent, from the gate of Ashwold."]</span>
                    </div>
                </div>
            }

            @if (_newGame)
            {
                <input class="aq-slot-nameinput" @bind="_newName" @bind:event="oninput"
                       maxlength="40" placeholder="@L["Name this delve"]" />
            }

            <div class="aq-heroes">
                @foreach (var hero in Heroes)
                {
                    <HeroCard Hero="hero"
                              Progress="ProgressFor(hero.Key)"
                              Selected="@(Lead == hero.Key)"
                              Locked="@(!IsUnlocked(hero.Key))"
                              SelectedChanged="SelectLead" />
                }
            </div>

            <button class="aq-btn aq-begin" @onclick="Begin">
                @L[_newGame || SelectedSave is null ? "Begin the Descent" : "Continue the Descent"]
            </button>

            <button type="button" class="aq-mute" title="@L["Mute / unmute the intro"]"
                    @onclick="ToggleMusic">@(Muted ? "🔇" : "🔊") <span>@L["Intro theme"]</span></button>
        }
    </div>
</div>
