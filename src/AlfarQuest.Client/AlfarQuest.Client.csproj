<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlfarQuest.Shared\AlfarQuest.Shared.csproj" />
  </ItemGroup>

  <!-- The raw sound pack — 300-odd files, most of them WAV duplicates of the OGG
       set and multi-megabyte ambience loops — is kept in the tree for reference
       but must never ship. Only the curated wwwroot/audio/sfx/ folder does. -->
  <ItemGroup>
    <Content Remove="wwwroot\audio\fx\**" />
    <None Include="wwwroot\audio\fx\**" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
