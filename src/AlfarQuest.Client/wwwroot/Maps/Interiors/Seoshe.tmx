 <objectgroup id="216" name="Interaction">
  <object id="10" name="the city gate" x="440.00" y="584.00">
   <properties>
    <property name="InteractionType" value="Examine"/>
    <property name="Verb" value="Read"/>
    <property name="ReadKind" value="plaque"/>
    <property name="Radius" value="44"/>
    <property name="Pages" value="&quot;SEOSHE.&quot; The crescent-coast city, and the finest den of thieves on the continent — though the sign does not say so. Its guard captains drink on the crews' coin, and the crews drink on theirs."/>
   </properties>
   <point/>
  </object>
  <object id="11" name="a proclamation" x="456.00" y="296.00">
   <properties>
    <property name="InteractionType" value="Examine"/>
    <property name="Verb" value="Read"/>
    <property name="ReadKind" value="plaque"/>
    <property name="Radius" value="44"/>
    <property name="Pages" value="Nailed to a post in the square. &quot;By order of the harbour watch: a stolen cargo — a red lacquer box, sought under the King's own seal. Any word of it, or of the crew that took it, to be brought forth at once.&quot; No reward is named. That, the old hands say, is a very bad sign."/>
   </properties>
   <point/>
  </object>
  <object id="12" name="House Cayhall" x="584.00" y="104.00">
   <properties>
    <property name="InteractionType" value="Examine"/>
    <property name="Verb" value="Read"/>
    <property name="ReadKind" value="plaque"/>
    <property name="Radius" value="44"/>
    <property name="Pages" value="The gates of House Cayhall. They deal in fine lumber and ores — or did, until a ship of theirs came into the Low Docks barely hauling anything, and a warehouse burned to the waterline the very night it berthed. The House has said nothing since."/>
   </properties>
   <point/>
  </object>
  <object id="13" name="the Neruum flotilla" x="728.00" y="216.00">
   <properties>
    <property name="InteractionType" value="Examine"/>
    <property name="Verb" value="Read"/>
    <property name="ReadKind" value="plaque"/>
    <property name="Radius" value="44"/>
    <property name="Pages" value="A harbour notice. &quot;The Neruum flotilla makes port at month's end — exotic spices, pelts and fabrics from far-off lands. Berths assigned at the Low Docks; manifests filed with the harbourmaster.&quot; The docks stagger out along the crescent like the teeth of a yawning beast."/>
   </properties>
   <point/>
  </object>
  <object id="14" name="the Low Docks" x="728.00" y="584.00">
   <properties>
    <property name="InteractionType" value="Examine"/>
    <property name="Verb" value="Read"/>
    <property name="ReadKind" value="plaque"/>
    <property name="Radius" value="44"/>
    <property name="Pages" value="&quot;THE LOW DOCKS.&quot; Gulls and cargo and every colour of merchant by day; and after dark, other trades entirely. High Street runs north from here to Baron Hill, if your coat is fine enough for the walk."/>
   </properties>
   <point/>
  </object>
 </objectgroup>
