@inherits LayoutComponentBase
@using AlfarQuest.Client.Components.Common
@using AlfarQuest.Client.Components.Navigation
@inject Translator L

@* The default frame: top bar, page, notifications.

   The game page does not use this — it wants the whole viewport and carries its
   own in-game menu — so it declares GameLayout instead. Keeping that a layout
   choice rather than a conditional in here means neither layout has to know the
   other exists. *@

<div class="aq-app">
    <TopNav />

    @* The skip link's target. Without it, reaching page content by keyboard means
       tabbing past the whole navigation on every single page. *@
    <a class="aq-skip" href="#main">@L["Skip to content"]</a>

    <main id="main" class="aq-shell" tabindex="-1">
        @Body
    </main>

    <ToastHost />
</div>
