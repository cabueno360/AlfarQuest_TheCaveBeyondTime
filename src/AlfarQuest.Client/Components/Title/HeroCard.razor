@using AlfarQuest.Client.Game
@using AlfarQuest.Client.Models
@using AlfarQuest.Client.Services.Character
@using AlfarQuest.Shared

@* One selectable delver on the title screen. A <button> rather than a <div>:
   it is reachable by keyboard and announces its own pressed state. *@
<button type="button"
        class="aq-hero-card @(Selected ? "selected" : "") @(Locked ? "locked" : "")"
        aria-pressed="@Selected" disabled="@Locked"
        @onclick="OnSelect">
    <div class="aq-portrait">
        <img src="@PortraitSrc" alt="" loading="lazy"
             onerror="this.closest('.aq-portrait').classList.add('no-art')" />
        <div class="aq-portrait-stub" style="background:@Def.SwatchCss"></div>
        <div class="aq-portrait-fade"></div>
        @if (Progress is not null)
        {
            <div class="aq-hero-level" title="Level @Progress.Level">Lv @Progress.Level</div>
        }
    </div>
    <div class="aq-hero-body">
        <div class="aq-hero-class" style="color:@Def.ColorAccent">@Hero.HeroClass</div>
        <div class="aq-hero-name">@Hero.Name</div>
        <div class="aq-hero-title">@Hero.Title</div>

        @if (Progress is not null)
        {
            @* What the save remembers about this hero: how far along, and what they
               are wearing. Each hero's own — the whole point of the change. *@
            <div class="aq-hero-xp" title="@Progress.Xp / @XpNext experience">
                <span class="aq-hero-xp-bar" style="width:@(XpPercent)%"></span>
            </div>
            <div class="aq-hero-gear">
                @foreach (var icon in EquipIcons)
                {
                    <span class="aq-hero-gear-slot">@icon</span>
                }
                @if (EquipIcons.Count == 0)
                {
                    <span class="aq-hero-gear-empty">No gear yet</span>
                }
            </div>
        }
        else
        {
            <div class="aq-hero-desc">@Hero.Description</div>
        }
    </div>
    <div class="aq-lead-badge">Leads the descent</div>
    @if (Locked)
    {
        <div class="aq-hero-locked">
            <span class="aq-hero-locked-icon">🔒</span>
            <span>Joins at the Cave</span>
        </div>
    }
</button>

@code {
    [Parameter, EditorRequired] public required HeroDto Hero { get; set; }

    /// <summary>This hero's saved progression, if there is a save. Null for a fresh
    /// recruit, and the card shows their story instead of a level.</summary>
    [Parameter] public SaveHeroDto? Progress { get; set; }

    [Parameter] public bool Selected { get; set; }

    /// <summary>A hero not yet available — the Cleric before he joins at the Cave.
    /// The card shows him and his story but cannot be chosen to lead.</summary>
    [Parameter] public bool Locked { get; set; }

    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    private Lore.HeroDef Def => Lore.ByKey(Hero.Key);
    private string PortraitSrc => $"assets/ui/hero-{Hero.Key}.png";

    private int XpNext => Progress is null ? 100 : Progression.XpForNext(Progress.Level);
    private int XpPercent => Progress is null ? 0
        : (int)Math.Clamp(100.0 * Progress.Xp / Math.Max(1, XpNext), 0, 100);

    /// <summary>Up to five worn-item icons, resolved from the saved ids. A preview,
    /// not the full loadout — the character window is where the detail lives.</summary>
    private IReadOnlyList<string> EquipIcons => Progress is null ? []
        : [.. Progress.Equipped.Select(id => ItemCatalog.Find(id)?.Icon)
            .Where(i => !string.IsNullOrEmpty(i)).Select(i => i!).Take(5)];

    private Task OnSelect() => Locked ? Task.CompletedTask : SelectedChanged.InvokeAsync(Hero.Key);
}
