@using AlfarQuest.Shared.Auth
@using AlfarQuest.Client.Services.Auth
@inject AuthenticationService Auth
@inject Translator L

@if (_sent)
{
    @* The same words whether or not that address is registered. Confirming which
       addresses exist here would undo the care taken on the sign-in form. *@
    <div class="aq-form-note" role="status">
        <p><strong>@L["If that address has an account, a reset link is on its way."]</strong></p>
        <p class="aq-hint">
            @L["Nothing arriving? Check the spelling and try again — and look in your spam folder."]
        </p>
        <a class="aq-link" href="/signin">@L["Back to sign in"]</a>
    </div>
}
else
{
    <EditForm Model="Model" OnValidSubmit="Submit" class="aq-form" novalidate>
    @* novalidate hands validation to Blazor alone. Without it the browser's own
       check on type="email" refuses to fire the submit event at all, so an
       invalid address silently suppressed every other field's error. *@

        <DataAnnotationsValidator />

        <FormErrorSummary Message="@_error" />

        <FormField Id="forgot-email" Label="@L["Email"]"
                   Hint="@L["We will send a link to set a new password."]">
            <InputText id="forgot-email" class="aq-input" @bind-Value="Model.Email"
                       type="email" autocomplete="username" placeholder="you@example.com"
                       @ref="_first" />
            <ValidationMessage For="@(() => Model.Email)" class="aq-field-error" />
        </FormField>

        <SubmitButton Label="@L["Send the Reset Link"]" BusyLabel="@L["Sending…"]" Busy="_busy" />

        <p class="aq-form-foot">
            @L["Remembered it?"] <a class="aq-link" href="/signin">@L["Sign in"]</a>
        </p>
    </EditForm>
}

@code {
    private readonly ForgotPasswordRequest Model = new();
    private InputText? _first;
    private bool _busy;
    private bool _sent;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _first?.Element is { } element) await element.FocusAsync();
    }

    private async Task Submit()
    {
        _busy = true;
        _error = null;

        var result = await Auth.ForgotPasswordAsync(Model);

        _busy = false;

        // Only a network failure is reported. Anything the server said about the
        // address itself is deliberately not shown.
        if (result.Ok) _sent = true; else _error = result.Error;
    }
}
