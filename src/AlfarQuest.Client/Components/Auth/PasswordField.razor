@inherits InputBase<string>
@inject Translator L

@* A password box with a reveal toggle.

   It derives from InputBase so it is a real form field rather than a styled box
   that happens to sit inside one. That inheritance is what gives it an
   EditContext: typing notifies the context, which revalidates *this* field on
   the spot.

   Written as a plain component first, it looked identical and was quietly
   broken — the model updated, but the context never heard about it, so a
   password error only appeared on a full submit and then stayed on screen after
   the password was corrected. Nothing on the page showed that; it took reading
   the validation store from inside the component to see it.

   Revealing helps more than it hurts on a device someone holds themselves — it
   is how a long passphrase gets typed correctly — so the toggle is offered,
   defaulting to hidden, and never persists across a page load. *@

<div class="aq-password">
    <input type="@(_shown ? "text" : "password")"
           id="@Id"
           class="aq-input @CssClass"
           value="@CurrentValueAsString"
           @oninput="OnInput"
           autocomplete="@AutoComplete"
           aria-describedby="@(Describedby)"
           placeholder="@Placeholder" />

    <button type="button" class="aq-password-toggle"
            @onclick="Toggle"
            aria-pressed="@(_shown ? "true" : "false")"
            aria-label="@(_shown ? L["Hide the password"] : L["Show the password"])"
            aria-controls="@Id"
            tabindex="-1">
        @(_shown ? "🙈" : "👁")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Tells the password manager what this box is for. "new-password" on
    /// a sign-up prompts a generated one; "current-password" on sign-in offers the
    /// saved one. Getting these wrong is why so many forms fight the browser.</summary>
    [Parameter] public string AutoComplete { get; set; } = "current-password";

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Set when the surrounding FormField renders a hint, so the hint is
    /// read out with the box rather than being visual-only.</summary>
    [Parameter] public bool HasHint { get; set; }

    private bool _shown;
    private string? Describedby => HasHint ? $"{Id}-hint" : null;

    private void Toggle() => _shown = !_shown;

    // Assigning through CurrentValueAsString is the whole point: it sets the bound
    // value *and* raises the field-changed notification the validator listens for.
    private void OnInput(ChangeEventArgs e) => CurrentValueAsString = e.Value?.ToString() ?? "";

    protected override bool TryParseValueFromString(
        string? value, out string result,
        [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        // A password is whatever was typed; there is nothing to parse and no way
        // for this step to fail.
        result = value ?? "";
        validationErrorMessage = null;
        return true;
    }
}
