@using AlfarQuest.Shared.Auth

@* Scored by the rule the server enforces, so the meter cannot promise something
   the API will then refuse. *@

<div class="aq-strength">
    <div class="aq-strength-bars" aria-hidden="true">
        @for (var i = 1; i <= 4; i++)
        {
            <span class="aq-strength-bar @(i <= Score ? Level : "")"></span>
        }
    </div>
    <span class="aq-strength-label @Level" aria-live="polite">
        @(string.IsNullOrEmpty(Password) ? "" : PasswordRules.Label(Score))
    </span>
</div>

@code {
    [Parameter] public string? Password { get; set; }

    private int Score => PasswordRules.Score(Password);

    private string Level => Score switch
    {
        <= 1 => "weak",
        2 => "fair",
        3 => "strong",
        _ => "excellent",
    };
}
