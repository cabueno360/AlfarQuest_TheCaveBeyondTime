@using AlfarQuest.Client.Components.Auth
@using Microsoft.AspNetCore.Components.Authorization

@* The application's top bar. Two faces of the same strip: the player menu once
   signed in, the way in before that. AuthorizeView decides which — so the bar
   cannot end up showing a sign-out button to someone who is not signed in. *@

<header class="aq-topnav">
    @* The wordmark is art, not a font. The text beside it is the fallback if the
       file is missing, so a fresh clone still shows a name rather than a broken
       image — the same arrangement the title screen uses. *@
    <a class="aq-topnav-brand" href="/" aria-label="Alfar Quest — home">
        <img class="aq-topnav-logo" src="assets/ui/wordmark.png" alt="Alfar Quest"
             onerror="this.closest('.aq-topnav-brand').classList.add('no-art')" />
        <span class="aq-topnav-wordmark">Alfar Quest</span>
    </a>

    <nav class="aq-topnav-links" aria-label="Main">
        <AuthorizeView>
            <Authorized>
                <a class="aq-topnav-link" href="/heroes">Play</a>
                <a class="aq-topnav-link" href="/profile">Profile</a>
                <PlayerMenu />
            </Authorized>
            <NotAuthorized>
                <a class="aq-topnav-link" href="/signin">Sign in</a>
                <a class="aq-btn aq-btn-sm" href="/signup">Create account</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
