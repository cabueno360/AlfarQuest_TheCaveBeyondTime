@using AlfarQuest.Client.Components.Auth
@using AlfarQuest.Client.Services.Auth
@using AlfarQuest.Client.Services.Profile
@using AlfarQuest.Shared.Auth
@inject ProfileService Profiles
@inject UserSessionService Session
@inject AlfarQuestAuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject Translator L

<EditForm Model="Model" OnValidSubmit="Save" class="aq-form" novalidate>
    @* novalidate hands validation to Blazor alone. Without it the browser's own
       check on type="email" refuses to fire the submit event at all, so an
       invalid address silently suppressed every other field's error. *@

    <DataAnnotationsValidator />

    <FormErrorSummary Message="@_error" />

    <FormField Id="pw-current" Label="@L["Current password"]">
        <PasswordField Id="pw-current" @bind-Value="Model.CurrentPassword" AutoComplete="current-password" />
        <ValidationMessage For="@(() => Model.CurrentPassword)" class="aq-field-error" />
    </FormField>

    <FormField Id="pw-new" Label="@L["New password"]"
               Hint="@L.Format("At least {0} characters.", PasswordRules.MinLength)">
        <PasswordField Id="pw-new" @bind-Value="Model.NewPassword" AutoComplete="new-password" HasHint="true" />
        <PasswordStrengthMeter Password="@Model.NewPassword" />
        <ValidationMessage For="@(() => Model.NewPassword)" class="aq-field-error" />
    </FormField>

    <FormField Id="pw-confirm" Label="@L["Confirm new password"]">
        <PasswordField Id="pw-confirm" @bind-Value="Model.ConfirmPassword" AutoComplete="new-password" />
        <ValidationMessage For="@(() => Model.ConfirmPassword)" class="aq-field-error" />
    </FormField>

    <p class="aq-hint">
        Changing your password signs you out everywhere, including here.
    </p>

    <SubmitButton Label="@L["Change password"]" BusyLabel="@L["Changing…"]" Busy="_busy" />
</EditForm>

@code {
    private readonly ChangePasswordRequest Model = new();
    private bool _busy;
    private string? _error;

    private async Task Save()
    {
        _busy = true;
        _error = null;

        var result = await Profiles.ChangePasswordAsync(Model);

        _busy = false;

        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        // The server revoked every session, this one included, so the token in
        // hand is already dead. Clearing it here rather than waiting for the next
        // request to fail keeps the app from spending a moment believing it is
        // signed in when it is not.
        await Session.EndAsync();
        AuthState.NotifyChanged();

        Notifications.Success(L["Password changed. Sign in with the new one."]);
        Nav.NavigateTo("/signin", replace: true);
    }
}
