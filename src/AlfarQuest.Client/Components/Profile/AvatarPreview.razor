@using AlfarQuest.Client.Components.Common
@inject Translator L

@* What the portrait will look like. Shows the pending image once one is chosen
   and the stored one otherwise, so "Upload" is confirming something already
   seen rather than a leap of faith. *@

<div class="aq-avatar-preview">
    @if (Pending is { Length: > 0 })
    {
        <span class="aq-avatar aq-avatar-lg">
            <img src="@Pending" alt="@L["The portrait about to be uploaded"]" class="aq-avatar-img" />
        </span>
        <span class="aq-avatar-badge" role="status">@L["Not saved yet"]</span>
    }
    else
    {
        <PlayerAvatar AvatarUrl="@AvatarUrl" Name="@Name" Size="lg" />
    }
</div>

@code {
    [Parameter] public string? AvatarUrl { get; set; }
    [Parameter] public string Name { get; set; } = "";

    /// <summary>A data: URL for the file the player just chose, read in the browser
    /// so the preview costs no round trip.</summary>
    [Parameter] public string? Pending { get; set; }
}
