@using AlfarQuest.Client.Components.Auth
@using AlfarQuest.Client.Services.Auth
@using AlfarQuest.Client.Services.Profile
@using AlfarQuest.Shared.Profiles
@inject ProfileService Profiles
@inject CurrentUserProvider Me
@inject NotificationService Notifications
@inject Translator L

<EditForm Model="Model" OnValidSubmit="Save" class="aq-form" novalidate>
    @* novalidate hands validation to Blazor alone. Without it the browser's own
       check on type="email" refuses to fire the submit event at all, so an
       invalid address silently suppressed every other field's error. *@

    <DataAnnotationsValidator />

    <FormErrorSummary Message="@_error" />

    <FormField Id="profile-name" Label="@L["Full name"]">
        <InputText id="profile-name" class="aq-input" @bind-Value="Model.FullName" autocomplete="name" />
        <ValidationMessage For="@(() => Model.FullName)" class="aq-field-error" />
    </FormField>

    @* Email is shown but not editable. Changing it has to be confirmed at the new
       address, and until that exists an editable box here would be a promise the
       server would refuse to keep. *@
    <FormField Id="profile-email" Label="@L["Email"]"
               Hint="@L["Changing your email will need confirmation — not available yet."]">
        <input id="profile-email" class="aq-input" type="email" value="@Me.Player?.Email" disabled readonly />
    </FormField>

    <div class="aq-form-split">
        <FormField Id="profile-country" Label="@L["Country"]" Required="false">
            <InputText id="profile-country" class="aq-input" @bind-Value="Model.Country" autocomplete="country-name" />
            <ValidationMessage For="@(() => Model.Country)" class="aq-field-error" />
        </FormField>

        <FormField Id="profile-phone" Label="@L["Phone"]" Required="false">
            <InputText id="profile-phone" class="aq-input" @bind-Value="Model.PhoneNumber" type="tel" autocomplete="tel" />
            <ValidationMessage For="@(() => Model.PhoneNumber)" class="aq-field-error" />
        </FormField>
    </div>

    <SubmitButton Label="@L["Save changes"]" BusyLabel="@L["Saving…"]" Busy="_busy" />
</EditForm>

@code {
    private UpdateProfileRequest Model = new();
    private bool _busy;
    private string? _error;

    // Seeded from the session rather than fetched: the profile is already in hand
    // by the time this renders, and a second request would only add a flicker.
    protected override void OnInitialized() => Model = new UpdateProfileRequest
    {
        FullName = Me.Player?.FullName ?? "",
        Country = Me.Player?.Country,
        PhoneNumber = Me.Player?.PhoneNumber,
    };

    private async Task Save()
    {
        _busy = true;
        _error = null;

        var result = await Profiles.UpdateAsync(Model);

        _busy = false;

        if (result.Ok) Notifications.Success(L["Your details have been saved."]);
        else _error = result.Error;
    }
}
