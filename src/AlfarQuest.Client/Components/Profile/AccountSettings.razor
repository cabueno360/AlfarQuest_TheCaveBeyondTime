@using AlfarQuest.Client.Services.Auth
@inject CurrentUserProvider Me
@inject AuthenticationService Auth
@inject NavigationManager Nav
@inject Translator L

@* Facts about the account rather than about the character: what it is, how it is
   secured, and the way out. *@

<dl class="aq-settings">
    <div class="aq-setting">
        <dt>@L["Sign-in method"]</dt>
        <dd>@L["Email and password"]</dd>
    </div>
    <div class="aq-setting">
        <dt>@L["Email confirmed"]</dt>
        <dd>
            <span class="aq-tag pending">@L["Not yet"]</span>
            <span class="aq-hint">@L["Confirmation is not sent yet — your account works without it."]</span>
        </dd>
    </div>
    <div class="aq-setting">
        <dt>@L["Two-factor"]</dt>
        <dd><span class="aq-tag pending">@L["Not available"]</span></dd>
    </div>
    <div class="aq-setting">
        <dt>@L["Account id"]</dt>
        <dd><code class="aq-code">@Me.Player?.Id</code></dd>
    </div>
</dl>

<div class="aq-settings-actions">
    <button type="button" class="aq-btn ghost" @onclick="SignOut">@L["Log out of this device"]</button>
</div>

@code {
    private async Task SignOut()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/", replace: true);
    }
}
