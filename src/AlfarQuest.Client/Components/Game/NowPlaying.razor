@inject Translator L

<div class="aq-topbar">
    <div class="aq-nowplaying">
        @* The track title and the band's name are not translated — a song keeps
           its name in every language. Only the label around them changes. *@
        <span>♪ @L["Now playing"] — <i>@Track</i> (@Artist)</span>
        <button title="@L["Mute / unmute"]" @onclick="OnToggle">@(Muted ? "🔇" : "🔊")</button>
    </div>
</div>

@code {
    [Parameter] public string Track { get; set; } = "";
    [Parameter] public string Artist { get; set; } = "Alfar Quest";
    [Parameter] public bool Muted { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
