@inject Translator L

@* Bottom-right, lifted above the canvas hotbar (which shares this corner) — see
   .aq-controls-help in game.css for the offset. The party panel owns bottom-left.

   Data-driven so a new binding is one row here and nowhere else. *@
<div class="aq-controls-help">
    @foreach (var (action, keys) in Bindings)
    {
        @* The action is translated; the keys are not. "WASD" and "Tab" are what
           is printed on the keyboard, and printing "TAB" in Portuguese would be
           naming a key that is not there. *@
        <div class="aq-key-row"><b>@L[action]</b> <span>@L[keys]</span></div>
    }
</div>

@code {
    private static readonly (string Action, string Keys)[] Bindings =
    [
        ("Move",         "WASD / arrows"),
        ("Aim",          "mouse"),
        ("Attack",       "J / left-click"),
        ("Skills",       "1 · 2 · 3 · 4"),
        ("Dash",         "Shift / Space"),
        ("Interact",     "E"),
        ("Switch hero",  "Tab"),
        ("Character",    "C"),
        ("Journal",      "L"),
    ];
}
