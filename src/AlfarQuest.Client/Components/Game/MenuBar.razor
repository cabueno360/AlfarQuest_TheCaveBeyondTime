@* Buttons for the menus a player might not think to press a key for. Sits with
   Abandon Delve in the top-right, the corner the canvas HUD leaves alone. *@
<div class="aq-menubar">
    <button class="aq-icon-btn" title="Character sheet (C)" @onclick="OnCharacter">
        <span class="aq-icon">🛡</span><span class="aq-icon-label">Character</span>
    </button>
    <button class="aq-btn ghost" @onclick="OnQuit">Abandon Delve</button>
</div>

@code {
    [Parameter] public EventCallback OnCharacter { get; set; }
    [Parameter] public EventCallback OnQuit { get; set; }
}
