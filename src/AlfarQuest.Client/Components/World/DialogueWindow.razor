@using AlfarQuest.Client.Game
@using AlfarQuest.Client.Models
@using AlfarQuest.Client.Services
@using AlfarQuest.Client.Services.Character
@implements IDisposable
@inject DialogueState Talk
@inject Translator L

@* A conversation with someone who has more than one thing to say.

   The concept art's "ideas of conversation" made literal: they greet you, and the
   questions you may put to them are listed to be chosen, not cycled through. Pick
   one and they answer — a long answer turns a leaf at a time — then you are back
   at the list, with what you have already asked marked, until you take your leave. *@

@if (Talk.Open is { } talk)
{
    <div class="aq-talk-scrim" @onclick="Close"></div>

    <section class="aq-talk" role="dialog" aria-modal="true" aria-label="@L.Format("Speaking with {0}", L[talk.Name])"
             tabindex="0" @ref="_panel" @onkeydown="OnKeyDown">

        <header class="aq-talk-head">
            @if (Portraits.Has(talk.Kind))
            {
                <img class="aq-talk-portrait-img" src="@Portraits.Path(talk.Kind)" alt="" aria-hidden="true" />
            }
            else
            {
                <span class="aq-talk-portrait" aria-hidden="true">@Portrait(talk.Role)</span>
            }
            <div class="aq-talk-who">
                <h2 class="aq-talk-name">@L[talk.Name]</h2>
                <p class="aq-talk-role">@L[talk.Role]</p>
            </div>
            <button class="aq-talk-close" aria-label="@L["Take your leave"]" @onclick="Close">✕</button>
        </header>

        @if (Talk.Offer is { } offer)
        {
            @* A quest laid out to accept or leave — its terms, and its reward, up front,
               so nobody takes on a delve without knowing what is on the table. *@
            <span class="aq-offer-eyebrow">✦ @L["New Quest"]</span>
            <h3 class="aq-offer-title">@L[offer.Title]</h3>
            <p class="aq-offer-summary">@L[offer.Summary]</p>

            @if (!offer.Reward.IsEmpty)
            {
                <div class="aq-offer-reward">
                    <span class="aq-offer-reward-label">@L["Reward"]</span>
                    <div class="aq-offer-chips">
                        @foreach (var chip in RewardChips(offer))
                        {
                            <span class="aq-offer-item" style="color:@chip.Colour">@chip.Icon&nbsp;@L[chip.Name]</span>
                        }
                        @if (offer.Reward.Xp > 0)
                        {
                            <span class="aq-offer-tally">+@offer.Reward.Xp @L["XP"]</span>
                        }
                        @if (offer.Reward.Gold > 0)
                        {
                            <span class="aq-offer-tally aq-offer-gold">+@offer.Reward.Gold @L["gold"]</span>
                        }
                    </div>
                </div>
            }

            <footer class="aq-talk-foot aq-offer-foot">
                <button class="aq-offer-decline" @onclick="Talk.DeclineOffer">@L["Maybe later"]</button>
                <button class="aq-talk-go aq-offer-accept" @onclick="Talk.AcceptOffer">@L["Accept the quest"]</button>
            </footer>
        }
        else if (Talk.Asked is { } asked)
        {
            @* An answer. The question is echoed above it so the exchange reads as one. *@
            <p class="aq-talk-asked">“@L[asked.Q]”</p>
            <p class="aq-talk-answer">@L[asked.A[Math.Min(Talk.Page, asked.A.Length - 1)]]</p>

            <footer class="aq-talk-foot">
                @if (asked.A.Length > 1)
                {
                    <span class="aq-talk-pages">@(Talk.Page + 1) / @asked.A.Length</span>
                }
                <button class="aq-talk-go" @onclick="Talk.Next">
                    @L[Talk.Page + 1 < asked.A.Length ? "Go on…"
                        : Talk.WillOffer(asked) ? "Hear them out…"
                        : "Ask something else"]
                </button>
            </footer>
        }
        else
        {
            @* The greeting, then everything you may ask. *@
            <p class="aq-talk-greeting">@L[talk.Greeting]</p>

            <ul class="aq-talk-topics">
                @foreach (var topic in talk.Topics)
                {
                    var heard = Talk.AlreadyAsked(topic);
                    <li>
                        <button type="button" class="aq-talk-topic @(heard ? "heard" : "")"
                                @onclick="() => Talk.Ask(topic)">
                            <span class="aq-talk-bullet" aria-hidden="true">@(heard ? "✓" : "❧")</span>
                            @L[topic.Q]
                        </button>
                    </li>
                }
            </ul>

            <footer class="aq-talk-foot">
                <button class="aq-talk-leave" @onclick="Close">@L["Take your leave"]</button>
            </footer>
        }
    </section>
}

@code {
    private ElementReference _panel;
    private bool _focus;

    protected override void OnInitialized() => Talk.Changed += Refresh;

    public void Dispose() => Talk.Changed -= Refresh;

    private void Refresh()
    {
        // Focus the panel the first frame it opens, so Escape and Enter reach it
        // instead of the canvas behind — otherwise WASD would still drive the hero.
        _focus = Talk.Open is not null;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focus && Talk.Open is not null)
        {
            _focus = false;
            try { await _panel.FocusAsync(); } catch { /* panel already gone */ }
        }
    }

    private void Close() => Talk.Close();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            // Escape backs out of a quest offer (leaving it on the table) before it
            // closes the whole conversation.
            case "Escape": if (Talk.Offer is not null) Talk.DeclineOffer(); else Close(); break;
            // Enter/Space accept an offer, else turn the page of an answer.
            case "Enter":
            case " ":
                if (Talk.Offer is not null) Talk.AcceptOffer();
                else if (Talk.Asked is not null) Talk.Next();
                break;
            case "Backspace":
                if (Talk.Offer is not null) Talk.DeclineOffer();
                else if (Talk.Asked is not null) Talk.BackToMenu();
                break;
        }
    }

    private sealed record Chip(string Name, string Icon, string Colour);

    /// <summary>The offered quest's item rewards as name/icon/rarity-colour, resolved
    /// from the catalogue — the same chips the completion toast shows.</summary>
    private static IReadOnlyList<Chip> RewardChips(QuestDef q) =>
        q.Reward.ItemIds
            .Select(ItemCatalog.Find)
            .Where(i => i is not null)
            .Select(i => new Chip(i!.Name, i.Icon, RarityInfo.Of(i.Rarity).Colour))
            .ToList();

    /// <summary>A glyph standing in for a portrait, chosen from the role — the same
    /// trick the shop counter uses, so a villager reads as themselves at a glance.</summary>
    private static string Portrait(string role) => role switch
    {
        var r when r.Contains("Cleric", StringComparison.OrdinalIgnoreCase) => "✝",
        var r when r.Contains("Wife", StringComparison.OrdinalIgnoreCase) => "❀",
        var r when r.Contains("Villager", StringComparison.OrdinalIgnoreCase) => "☖",
        var r when r.Contains("Academy", StringComparison.OrdinalIgnoreCase) => "✦",
        var r when r.Contains("Adventurer", StringComparison.OrdinalIgnoreCase) => "⚔",
        _ => "☗",
    };
}
