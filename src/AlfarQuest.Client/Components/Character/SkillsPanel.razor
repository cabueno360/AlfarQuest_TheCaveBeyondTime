@using AlfarQuest.Client.Models
@using AlfarQuest.Client.Services.Character

@* Grouped by category straight from the catalogue — Combat, Magic, Passive and
   Crafting appear because skills carry one, not because this file lists them. *@
<section class="aq-cw-panel">
    <h3 class="aq-cw-panel-title">
        Skills
        @if (Character.SkillPoints > 0)
        {
            <span class="aq-cw-badge skill">@Character.SkillPoints to spend</span>
        }
    </h3>

    @foreach (var group in SkillCatalog.ForClass(Character.Class))
    {
        <h4 class="aq-skill-cat">@group.Key</h4>
        <div class="aq-skills">
            @foreach (var s in group)
            {
                <SkillCard Skill="s" Rank="Character.RankOf(s)"
                           CanLearn="Character.CanLearn(s)" OnLearn="OnLearn" />
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public required Character Character { get; set; }
    [Parameter] public EventCallback<Skill> OnLearn { get; set; }
}
