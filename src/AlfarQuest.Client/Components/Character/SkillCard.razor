@using AlfarQuest.Client.Models

<div class="aq-skill @(Maxed ? "maxed" : "")" title="@Skill.Description">
    <span class="aq-skill-icon">@Skill.Icon</span>
    <div class="aq-skill-body">
        <div class="aq-skill-head">
            <span class="aq-skill-name">@Skill.Name</span>
            <span class="aq-skill-rank">@Rank / @Skill.MaxLevel</span>
        </div>
        <div class="aq-skill-pips">
            @for (var i = 0; i < Skill.MaxLevel; i++)
            {
                <span class="aq-pip @(i < Rank ? "on" : "")"></span>
            }
        </div>
        <p class="aq-skill-next">
            @(Maxed ? "Mastered." : $"Next: {Skill.NextBonus(Rank)}")
        </p>
    </div>
    <button class="aq-mini-btn" disabled="@(!CanLearn)"
            title="@(Maxed ? "Mastered" : CanLearn ? $"Costs {Skill.CostFor(Rank)} skill point(s)" : "Not enough skill points")"
            @onclick="Learn">+</button>
</div>

@code {
    [Parameter, EditorRequired] public required Skill Skill { get; set; }
    [Parameter] public int Rank { get; set; }
    [Parameter] public bool CanLearn { get; set; }
    [Parameter] public EventCallback<Skill> OnLearn { get; set; }

    private bool Maxed => Rank >= Skill.MaxLevel;
    private Task Learn() => CanLearn ? OnLearn.InvokeAsync(Skill) : Task.CompletedTask;
}
