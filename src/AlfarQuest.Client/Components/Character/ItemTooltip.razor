@using AlfarQuest.Client.Models
@inject Translator L

@* Shown on hover over a filled slot. Positioned by the slot, so this only knows
   how to describe an item. *@
<div class="aq-tip">
    <div class="aq-tip-name" style="color:@Info.Colour">@L[Item.Name]</div>
    <div class="aq-tip-kind">@L[Info.Name] @L[SlotInfo.Of(Item.Slot).Name]</div>
    <ul class="aq-tip-bonuses">
        @foreach (var line in Item.Bonuses(s => L[s], (f, a) => L.Format(f, a)))
        {
            <li>@line</li>
        }
    </ul>
    @if (!string.IsNullOrWhiteSpace(Item.Flavour))
    {
        <p class="aq-tip-flavour">@L[Item.Flavour]</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public required Item Item { get; set; }
    private RarityInfo Info => RarityInfo.Of(Item.Rarity);
}
