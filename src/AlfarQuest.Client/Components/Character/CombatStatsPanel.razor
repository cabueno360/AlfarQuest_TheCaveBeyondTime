@using AlfarQuest.Client.Models
@using AlfarQuest.Client.Services.Character

@* Every row is computed from the character's attributes by StatCalculator — the
   same function the simulation uses, so these are the real numbers. *@
<section class="aq-cw-panel">
    <h3 class="aq-cw-panel-title">Combat</h3>
    <div class="aq-stats">
        @foreach (var s in StatCalculator.For(Character))
        {
            <div class="aq-stat" title="@s.Description">
                <span class="aq-stat-name">@s.Name</span>
                <span class="aq-stat-val">@s.Value</span>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required Character Character { get; set; }
}
