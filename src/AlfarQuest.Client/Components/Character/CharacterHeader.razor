@using AlfarQuest.Client.Models

<header class="aq-cw-header">
    <h2 class="aq-cw-name">@Character.Name</h2>
    <p class="aq-cw-title">@Character.Title</p>
    <dl class="aq-cw-idents">
        <div><dt>Race</dt><dd>@Character.Race</dd></div>
        <div><dt>Class</dt><dd style="color:@Character.Def.ColorAccent">@Character.Class</dd></div>
        <div><dt>Level</dt><dd>@Character.Level</dd></div>
    </dl>
</header>

@code {
    [Parameter, EditorRequired] public required Character Character { get; set; }
}
