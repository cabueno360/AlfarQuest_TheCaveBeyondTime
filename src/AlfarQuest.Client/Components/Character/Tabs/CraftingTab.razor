@using AlfarQuest.Client.Models
@using AlfarQuest.Client.Services
@inject PartyState Party

@* Crafting, promoted from a strip inside the old scrolling column to its own
   tab. The recipes and the gate are unchanged — what a craftsman will make is
   still decided by standing next to one. *@

<div class="aq-tab-grid two">
    <section class="aq-card">
        <header class="aq-card-head">
            <h3 class="aq-card-title"><span class="aq-card-icon" aria-hidden="true">🔨</span> Recipes</h3>
            @if (!AtStation)
            {
                <span class="aq-card-hint">Find a craftsman to work</span>
            }
        </header>
        <div class="aq-card-body">
            <CraftingPanel Pouch="Party.Pouch" Purse="Party.PurseFor(Character)"
                           AtStation="AtStation" OnCraft="Craft" />
        </div>
    </section>

    <div class="aq-stack">
        <section class="aq-card">
            <header class="aq-card-head">
                <h3 class="aq-card-title"><span class="aq-card-icon" aria-hidden="true">◆</span> Materials</h3>
            </header>
            <div class="aq-card-body">
                <MaterialsPanel Pouch="Party.Pouch" />
            </div>
        </section>

        <section class="aq-card">
            <header class="aq-card-head">
                <h3 class="aq-card-title"><span class="aq-card-icon" aria-hidden="true">◈</span> Purse</h3>
            </header>
            <div class="aq-card-body">
                <MoneyPanel Wallet="Party.PurseFor(Character)" />
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required Models.Character Character { get; set; }
    [Parameter] public bool AtStation { get; set; }

    // The crafter is whoever's sheet is open — the material cost comes from the
    // shared pouch, the coin from this hero's purse, the result into their pack.
    private void Craft(Recipe r) => Party.Craft(r);
}
